#!/bin/bash
set -e

root=$(cd "$(dirname "$0")/.." && pwd)
base="${TMPDIR:-/tmp}"
[[ -d /tmp/opencode ]] && base=/tmp/opencode
sandbox=$(mktemp -d "$base/auto-theme-ui.XXXXXX")
trap 'rm -rf "$sandbox"' EXIT

for module in Commons Ui; do
    ln -s "${OMARCHY_PATH:-/usr/share/omarchy}/shell/$module" "$sandbox/$module"
done
cp "$root"/{Choice,Location,Segments,Warmth}.qml "$sandbox/"
# Test the actual IPC block without loading the layer-shell popup offscreen.
{ printf '%s\n' 'import QtQuick' 'import Quickshell.Io' 'import qs.Commons' 'Item { id: root'
  printf '%s\n' 'property string ipcTarget: "auto-theme-test"' 'property int refreshes: 0'
  printf '%s\n' 'property alias handler: ipcHandler' 'function refresh() { refreshes++ }'
  sed -n '/^  IpcHandler {$/,/^  }$/p' "$root/Widget.qml"
  printf '%s\n' '}'
} >"$sandbox/WidgetIpc.qml"
cp "$root/tests/ui.qml" "$sandbox/shell.qml"
mkdir "$sandbox/bin"
cp "$root/tests/ui-curl" "$sandbox/bin/curl"
PATH="$sandbox/bin:$PATH" QT_QPA_PLATFORM=offscreen timeout 10 quickshell -p "$sandbox/shell.qml" --no-color >"$sandbox/log" 2>&1
cat "$sandbox/log"
grep -q 'PASS: popup widths' "$sandbox/log"
! grep -Eq 'FAIL:|ERROR:|ReferenceError|TypeError' "$sandbox/log"

#!/bin/bash
set -e

root=$(cd "$(dirname "$0")/.." && pwd)
base="${TMPDIR:-/tmp}"
[[ -d /tmp/opencode ]] && base=/tmp/opencode
sandbox=$(mktemp -d "$base/auto-theme-clipboard.XXXXXX")
trap 'rm -rf "$sandbox"' EXIT

"${CXX:-c++}" -fPIC "$root/tests/clipboard.cpp" -o "$sandbox/check" $(pkg-config --cflags --libs Qt6Quick Qt6Qml Qt6Gui)
QT_QPA_PLATFORM=offscreen timeout 10 "$sandbox/check"

#!/bin/bash

# Auto theme switcher based on sunrise/sunset.

CONFIG_DIR="$HOME/.config/omarchy/auto-theme"
CONFIG_FILE="$CONFIG_DIR/config"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/auto-theme"
IP_CACHE="$STATE_DIR/location.cache"
IP_FAILED="$STATE_DIR/location.failed"
IP_PLACE="$STATE_DIR/location.place"
PREVIEW_FILE="$STATE_DIR/preview"
CURRENT_DIR="$HOME/.local/state/omarchy/current"
export OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}"
IMAGE_TYPES=(-iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.gif' -o -iname '*.bmp' -o -iname '*.webp')
TIMER="omarchy-auto-theme.timer"
SERVICE="omarchy-auto-theme.service"
LEGACY_NEXT_TIMER="omarchy-auto-theme-next.timer"
NEXT_PREFIX="omarchy-auto-theme-next"
SELF=$(readlink -f "$0")
SCRIPT_DIR=$(dirname "$SELF")
UNIT_SOURCE="$SCRIPT_DIR/../systemd"
USER_UNITS="$HOME/.config/systemd/user"
# The shipped units point at the standard plugin path so that installs which
# linked them keep working; generated copies point at this checkout instead.
STANDARD_SELF="%h/.config/omarchy/plugins/mwikala.auto-theme/bin/omarchy-auto-theme"
UNIT_MARKER="# Generated by omarchy-auto-theme"
CONFIG_KEYS=(LIGHT_THEME DARK_THEME LIGHT_BACKGROUND DARK_BACKGROUND NIGHTLIGHT
             NIGHTLIGHT_TEMPERATURE TEMPERATURE_DISPLAY LOCATION LOCATION_NAME LOCATION_LOOKUP)
MIN_TEMPERATURE=2500
MAX_TEMPERATURE=5500
NEUTRAL_TEMPERATURE=6500
PREVIEW_SECONDS=30
LOCK_FD=200
WATCHDOG_FD=201

COORDS=""

die() { echo "$*" >&2; exit 1; }

# Children must not inherit the lock: omarchy-theme-set and hyprsunset leave
# processes behind that would otherwise hold it until they exit.
unlocked() { "$@" 200>&- 201>&-; }

lock() {
    mkdir -p "$STATE_DIR"
    exec 200>>"$STATE_DIR/lock"
    flock -w 60 "$LOCK_FD" || die "Another Auto Theme change is still running; try again."
}

load_defaults() {
    LIGHT_THEME="Flexoki Light"
    DARK_THEME="Matte Black"
    LIGHT_BACKGROUND=""
    DARK_BACKGROUND=""
    NIGHTLIGHT="off"
    NIGHTLIGHT_TEMPERATURE=4000
    TEMPERATURE_DISPLAY="name"
    LOCATION=""
    LOCATION_NAME=""
    LOCATION_LOOKUP="ip"
}

# The config is parsed as data. Sourcing it would run any theme or background
# name that happened to contain shell syntax.
read_config() {
    local line key value

    load_defaults
    if [[ -f "$CONFIG_FILE" ]]; then
        while IFS= read -r line || [[ -n "$line" ]]; do
            [[ "$line" =~ ^[[:space:]]*([A-Z_]+)=(.*)$ ]] || continue
            key="${BASH_REMATCH[1]}"
            value="${BASH_REMATCH[2]}"
            if [[ "$value" =~ ^\"(.*)\"[[:space:]]*$ || "$value" =~ ^\'(.*)\'[[:space:]]*$ ]]; then
                value="${BASH_REMATCH[1]}"
            else
                value="${value%"${value##*[![:space:]]}"}"
            fi

            case " ${CONFIG_KEYS[*]} " in
                *" $key "*) printf -v "$key" '%s' "$value" ;;
            esac
        done <"$CONFIG_FILE"
    fi

    [[ "$NIGHTLIGHT" =~ ^(on|off|auto)$ ]] || NIGHTLIGHT=off
    valid_temperature "$NIGHTLIGHT_TEMPERATURE" || NIGHTLIGHT_TEMPERATURE=4000
    [[ "$TEMPERATURE_DISPLAY" =~ ^(name|kelvin)$ ]] || TEMPERATURE_DISPLAY=name
    [[ -z "$LOCATION" ]] || valid_location "$LOCATION" || LOCATION=""
    [[ "$LOCATION_LOOKUP" == off ]] || LOCATION_LOOKUP=ip
}

save_config() {
    local target tmp key

    mkdir -p "$CONFIG_DIR"
    target=$(readlink -f "$CONFIG_FILE" 2>/dev/null || echo "$CONFIG_FILE")
    mkdir -p "$(dirname "$target")"
    tmp=$(mktemp "$target.XXXXXX") || die "Could not write $CONFIG_FILE"

    {
        echo "# Auto Theme. Values are read as data, never run as shell code."
        for key in "${CONFIG_KEYS[@]}"; do
            printf '%s="%s"\n' "$key" "${!key}"
        done
    } >"$tmp" && mv "$tmp" "$target" || { rm -f "$tmp"; die "Could not write $CONFIG_FILE"; }
}

valid_text() { [[ "$1" != *[$'\n\r"']* ]]; }

valid_location() {
    [[ "$1" =~ ^(-?[0-9]+(\.[0-9]+)?)[[:space:]]+(-?[0-9]+(\.[0-9]+)?)$ ]] || return 1
    awk -v lat="${BASH_REMATCH[1]}" -v lon="${BASH_REMATCH[3]}" \
        'BEGIN { exit !(lat >= -90 && lat <= 90 && lon >= -180 && lon <= 180) }'
}

valid_temperature() {
    [[ "$1" =~ ^[0-9]+$ ]] && (( 10#$1 >= MIN_TEMPERATURE && 10#$1 <= MAX_TEMPERATURE ))
}

atomic_write() {
    local file="$1" tmp

    mkdir -p "$(dirname "$file")"
    tmp=$(mktemp "$file.XXXXXX") || return 1
    printf '%s\n' "$2" >"$tmp" && mv "$tmp" "$file"
}

state() { cat "$STATE_DIR/$1" 2>/dev/null; }
set_state() { atomic_write "$STATE_DIR/$1" "$2"; }

needs_migration() {
    [[ -e "$CONFIG_DIR/mode" || -e "$CONFIG_DIR/auto" || -e "$CONFIG_DIR/scheduled" || -e "$CONFIG_DIR/location.cache" ]] ||
        [[ -f "$CONFIG_FILE" && ! -e "$STATE_DIR/auto" ]]
}

# Older versions kept state beside the config, and the oldest had no auto flag
# because an active timer meant auto.
migrate() {
    local name

    needs_migration || return 0
    lock
    for name in mode auto location.cache; do
        if [[ -f "$CONFIG_DIR/$name" && ! -e "$STATE_DIR/$name" ]]; then
            mv "$CONFIG_DIR/$name" "$STATE_DIR/$name"
        fi
    done
    rm -f "$CONFIG_DIR/scheduled"

    if [[ ! -e "$STATE_DIR/auto" ]]; then
        if [[ "$(systemctl --user is-active "$TIMER" 2>/dev/null)" == active ]]; then
            set_state auto 1
        else
            set_state auto 0
        fi
    fi
    exec 200>&-
}

lookup_ip() {
    local answer loc place

    if [[ -f "$IP_CACHE" ]] && (( $(date +%s) - $(stat -c %Y "$IP_CACHE") < 86400 )); then
        return 0
    fi
    if [[ -f "$IP_FAILED" ]] && (( $(date +%s) - $(stat -c %Y "$IP_FAILED") < 3600 )); then
        echo "Couldn't find your location. Set it manually or try later." >&2
        return 1
    fi

    answer=$(unlocked curl -fsS --max-time 5 https://ipinfo.io/json 2>/dev/null)
    loc=$(jq -r '.loc // empty' <<<"$answer" 2>/dev/null)
    loc="${loc%%,*} ${loc#*,}"
    place=$(jq -r '.city // .region // .country // empty' <<<"$answer" 2>/dev/null | tr -d '[:cntrl:]')
    if valid_location "$loc"; then
        rm -f "$IP_FAILED"
        atomic_write "$IP_CACHE" "$loc"
        atomic_write "$IP_PLACE" "$place"
        return 0
    fi

    mkdir -p "$STATE_DIR" && touch "$IP_FAILED"
    echo "Couldn't find your location. Set it manually or try later." >&2
    return 1
}

# Contacts the network, so callers run it before taking the lock.
refresh_location() {
    valid_location "$LOCATION" && return 0
    [[ "$LOCATION_LOOKUP" == ip ]] && lookup_ip
}

# Sets COORDS from configuration and caches only: never fetches. A stale
# automatic fix still beats none while offline.
locate() {
    COORDS=""
    if valid_location "$LOCATION"; then
        COORDS="$LOCATION"
        return 0
    fi

    [[ "$LOCATION_LOOKUP" == ip && -f "$IP_CACHE" ]] || return 1
    COORDS=$(<"$IP_CACHE")
    valid_location "$COORDS" || { COORDS=""; return 1; }
}

# For explicit commands: a failed lookup is fatal only without a cached fix,
# and then its own message is the one reported.
ensure_location() {
    location_configured || die "$LOCATION_HINT"
    refresh_location && return 0
    locate || exit 1
}

location_configured() { valid_location "$LOCATION" || [[ "$LOCATION_LOOKUP" != off ]]; }

location_source() {
    valid_location "$LOCATION" && { echo manual; return; }
    echo "$LOCATION_LOOKUP"
}

place() {
    case "$(location_source)" in
        manual) echo "$LOCATION_NAME" ;;
        ip) [[ -n "$COORDS" ]] && cat "$IP_PLACE" 2>/dev/null ;;
    esac
}

LOCATION_HINT='Set a location first: omarchy-auto-theme location auto or location "LAT LON"'

sun_issue() {
    command -v sunwait >/dev/null || { echo sunwait; return; }
    [[ -n "$COORDS" ]] || echo location
}

require_sun() {
    case "$(sun_issue)" in
        sunwait) die "Install sunwait to follow sunrise and sunset." ;;
        location) die "$LOCATION_HINT" ;;
    esac
}

sun_coords() {
    local lat lon lat_dir=N lon_dir=E

    read -r lat lon <<<"$COORDS"
    [[ "$lat" == -* ]] && { lat_dir=S; lat="${lat#-}"; }
    [[ "$lon" == -* ]] && { lon_dir=W; lon="${lon#-}"; }
    echo "${lat}${lat_dir} ${lon}${lon_dir}"
}

# Prints the local HH:MM of rise or set on a date, failing on polar days and
# nights when the event does not happen.
sun_time() {
    local event="$1" day="${2:-$(date +%F)}" time

    [[ -n "$COORDS" ]] || return 1
    # shellcheck disable=SC2046
    time=$(sunwait list "$event" d "$(date -d "$day" +%-d)" m "$(date -d "$day" +%-m)" y "$(date -d "$day" +%y)" \
        $(sun_coords) 2>/dev/null)
    [[ "$time" =~ ^[0-2][0-9]:[0-5][0-9]$ ]] || return 1
    echo "$time"
}

# poll still answers DAY or NIGHT when there is no sunrise or sunset.
sun_phase() {
    [[ -n "$COORDS" ]] || return 1
    # shellcheck disable=SC2046
    case "$(sunwait poll $(sun_coords) 2>/dev/null)" in
        DAY) echo light ;;
        NIGHT) echo dark ;;
        *) return 1 ;;
    esac
}

# Prints "epoch event" for the next sunrise or sunset within two days, or a
# check shortly after midnight when there is none (polar day or night).
next_event() {
    local now today tomorrow day event time at best="" best_event=""

    now=$(date +%s)
    today=$(date +%F)
    tomorrow=$(date -d "$today 12:00 +1 day" +%F)

    for day in "$today" "$tomorrow"; do
        for event in rise set; do
            time=$(sun_time "$event" "$day") || continue
            at=$(date -d "$day $time" +%s) || continue
            # A run triggered a minute after the event must book the next one.
            (( at + 60 > now )) || continue
            if [[ -z "$best" ]] || (( at < best )); then
                best=$at
                best_event="sun$event"
            fi
        done
    done

    if [[ -n "$best" ]]; then
        echo "$best $best_event"
    else
        echo "$(date -d "$tomorrow 00:05" +%s) check"
    fi
}

theme_for() { [[ "$1" == light ]] && echo "$LIGHT_THEME" || echo "$DARK_THEME"; }
background_for() { [[ "$1" == light ]] && echo "$LIGHT_BACKGROUND" || echo "$DARK_BACKGROUND"; }
theme_var() { [[ "$1" == light ]] && echo LIGHT_THEME || echo DARK_THEME; }
background_var() { [[ "$1" == light ]] && echo LIGHT_BACKGROUND || echo DARK_BACKGROUND; }
current_theme() { cat "$CURRENT_DIR/theme.name" 2>/dev/null; }

# Same normalisation as omarchy-theme-set.
theme_slug() { sed -E 's/<[^>]+>//g' <<<"$1" | tr '[:upper:]' '[:lower:]' | tr ' ' '-'; }

theme_exists() { omarchy-theme-list 2>/dev/null | grep -Fxq -- "$1"; }

# Mirrors the search order in omarchy-theme-bg-next, so a pinned background is a
# path that script recognises and keeps cycling from.
background_dirs() {
    local slug="$1"

    echo "$HOME/.config/omarchy/backgrounds/$slug"
    [[ "$(current_theme)" == "$slug" ]] && echo "$CURRENT_DIR/theme/backgrounds"
    echo "$HOME/.config/omarchy/themes/$slug/backgrounds"
    echo "$OMARCHY_PATH/themes/$slug/backgrounds"
}

background_list() {
    local dirs=()

    mapfile -t dirs < <(background_dirs "$1")
    find -L "${dirs[@]}" -maxdepth 1 -type f \( "${IMAGE_TYPES[@]}" \) -printf '%f\n' 2>/dev/null | sort -u
}

background_path() {
    local dir

    while read -r dir; do
        [[ -f "$dir/$2" ]] && { echo "$dir/$2"; return 0; }
    done < <(background_dirs "$1")
    return 1
}

apply_background() {
    local path

    path=$(background_path "$1" "$2") || return 1
    unlocked omarchy-theme-bg-set "$path" >/dev/null 2>&1
}

# Records the mode only once the theme is actually in place.
set_theme() {
    local mode="$1" theme background slug log

    theme=$(theme_for "$mode")
    background=$(background_for "$mode")
    slug=$(theme_slug "$theme")

    if [[ "$(current_theme)" != "$slug" ]]; then
        log=$(mktemp "$STATE_DIR/theme-set.XXXXXX")
        # Skipping omarchy's own background avoids a visible transition to its
        # choice before the pinned one lands.
        if ! unlocked env OMARCHY_THEME_SKIP_BACKGROUND="${background:+1}" omarchy-theme-set "$theme" </dev/null >"$log" 2>&1; then
            echo "Could not apply $theme: $(tail -n 3 "$log")" >&2
            rm -f "$log"
            return 1
        fi
        rm -f "$log"

        if [[ -n "$background" ]] && ! apply_background "$slug" "$background"; then
            unlocked omarchy-theme-bg-next >/dev/null 2>&1
        fi
    fi

    set_state mode "$mode"
}

current_temperature() {
    unlocked hyprctl hyprsunset temperature 2>/dev/null | grep -oE '[0-9]+' | head -n1
}

# A freshly started hyprsunset applies its default at the end of its boot, so
# the value is resent until it sticks, as omarchy-toggle-nightlight does.
apply_temperature() {
    local target="$1" attempt

    if ! pgrep -x hyprsunset >/dev/null; then
        (( target == NEUTRAL_TEMPERATURE )) && return 0
        unlocked setsid -f uwsm-app -- hyprsunset </dev/null >/dev/null 2>&1
    fi

    for attempt in {1..15}; do
        unlocked hyprctl hyprsunset temperature "$target" >/dev/null 2>&1
        if [[ "$(current_temperature)" == "$target" ]]; then
            unlocked omarchy-shell -q nightlight refresh >/dev/null 2>&1
            return 0
        fi
        sleep 0.2
    done

    echo "Could not set night light to ${target}K; is hyprsunset running?" >&2
    return 1
}

set_nightlight() {
    local temperature=$NEUTRAL_TEMPERATURE

    [[ "$1" == on ]] && temperature=$NIGHTLIGHT_TEMPERATURE
    apply_temperature "$temperature" || return 1
    set_state nightlight "$1"
}

# Without a phase, auto keeps whatever it last applied.
wanted_nightlight() {
    local phase="$1"

    case "$NIGHTLIGHT" in
        on|off) echo "$NIGHTLIGHT" ;;
        auto)
            [[ -n "$phase" ]] || phase=$(sun_phase) || { state nightlight || echo off; return; }
            [[ "$phase" == dark ]] && echo on || echo off
            ;;
    esac
}

theme_follows_sun() { [[ "$(state auto)" == 1 ]]; }
nightlight_follows_sun() { [[ "$NIGHTLIGHT" == auto ]]; }
follows_sun() { theme_follows_sun || nightlight_follows_sun; }

systemd_quote() {
    local value="${1//\\/\\\\}"

    value="${value//\"/\\\"}"
    value="${value//\%/%%}"
    printf '"%s"' "${value//\$/\$\$}"
}

# Units are generated so ExecStart names this checkout wherever it lives.
render_unit() {
    local unit="$1" content

    content=$(<"$UNIT_SOURCE/$unit") || return 1
    content="${content//"ConditionPathExists=$STANDARD_SELF"/"ConditionPathExists=${SELF//\%/%%}"}"
    content="${content//"ExecStart=$STANDARD_SELF"/"ExecStart=$(systemd_quote "$SELF")"}"
    printf '%s\n%s\n' "$UNIT_MARKER" "$content"
}

ours() { [[ -L "$1" ]] || { [[ -f "$1" ]] && grep -Fxq "$UNIT_MARKER" "$1"; }; }

install_units() {
    local unit file content changed=0

    mkdir -p "$USER_UNITS"
    for unit in "$SERVICE" "$TIMER"; do
        file="$USER_UNITS/$unit"
        content=$(render_unit "$unit") || { echo "Missing unit template: $UNIT_SOURCE/$unit" >&2; return 1; }
        [[ ! -L "$file" && -f "$file" && "$(<"$file")" == "$content" ]] && continue
        [[ -e "$file" || -L "$file" ]] && ! ours "$file" && continue

        rm -f "$file"
        printf '%s\n' "$content" >"$file" || return 1
        changed=1
    done

    (( changed )) && systemctl --user daemon-reload
    return 0
}

stop_next_timers() {
    # A missing legacy unit makes systemctl reject the entire batch.
    systemctl --user stop "$LEGACY_NEXT_TIMER" >/dev/null 2>&1
    systemctl --user stop "$NEXT_PREFIX-*.timer" >/dev/null 2>&1
}

disable_timer() {
    systemctl --user disable --now "$TIMER" >/dev/null 2>&1
    stop_next_timers
    rm -f "$STATE_DIR/scheduled"
}

# The hourly timer stays on while anything follows the sun and a location
# source exists, so a missing sunwait or a failed lookup can recover.
sync_timer() {
    if follows_sun && location_configured; then
        install_units || return 1
        systemctl --user enable --now "$TIMER" >/dev/null 2>&1 ||
            { echo "Could not enable $TIMER" >&2; return 1; }
        return 0
    fi

    disable_timer
}

# Each booking gets a fresh transient name: the service running this function
# may still own the previous one.
schedule_next() {
    local at event phase="" unit

    stop_next_timers
    rm -f "$STATE_DIR/scheduled"
    follows_sun || return 0
    [[ -z "$(sun_issue)" ]] || return 0

    read -r at event < <(next_event)
    [[ "$event" == sunrise ]] && phase=light
    [[ "$event" == sunset ]] && phase=dark
    unit="$NEXT_PREFIX-$(date +%s%N)"

    if ! systemd-run --user --collect --quiet \
        --unit="$unit" \
        --on-calendar="$(date -d "@$((at + 60))" '+%F %T')" \
        --description="Auto Theme: $event" \
        "$SELF" trigger $phase >/dev/null 2>&1; then
        echo "Could not schedule the next change." >&2
        return 1
    fi

    set_state scheduled "$at $event"
}

apply_theme_phase() {
    [[ -n "$1" ]] || return 0
    [[ "$2" == 1 || "$(state mode)" != "$1" ]] || return 0
    set_theme "$1"
}

apply_nightlight() {
    [[ "$2" == 1 || "$(state nightlight)" != "$1" ]] || return 0
    set_nightlight "$1"
}

refresh_widget() { unlocked timeout 2 omarchy-shell -q mwikala.auto-theme refresh >/dev/null 2>&1; }

# A scheduled event passes the phase it was booked for, so it does not depend
# on sunwait agreeing at the boundary minute. Hourly checks only act when the
# phase changed, which leaves manual changes in between alone.
trigger() {
    local phase="$1" force=0 failed=0

    case "$phase" in ""|light|dark) ;; *) die "Usage: omarchy-auto-theme trigger [light|dark]" ;; esac
    [[ -n "$phase" ]] && force=1

    read_config
    follows_sun && location_configured && refresh_location

    lock
    read_config
    locate
    sync_timer || failed=1
    follows_sun || return 0

    if [[ -n "$(sun_issue)" ]]; then
        stop_next_timers
        rm -f "$STATE_DIR/scheduled"
        [[ "$(sun_issue)" == sunwait ]] && echo "Install sunwait to follow sunrise and sunset." >&2
        [[ "$(sun_issue)" == location ]] && echo "$LOCATION_HINT" >&2
        refresh_widget
        return 0
    fi

    [[ -n "$phase" ]] || phase=$(sun_phase)
    if theme_follows_sun; then
        apply_theme_phase "$phase" "$force" || failed=1
    fi
    if nightlight_follows_sun && [[ -n "$phase" ]]; then
        apply_nightlight "$(wanted_nightlight "$phase")" "$force" || failed=1
    fi
    schedule_next || failed=1
    refresh_widget
    return "$failed"
}

enable_auto_theme() {
    local phase

    read_config
    command -v sunwait >/dev/null || die "Install sunwait to follow sunrise and sunset."
    ensure_location

    lock
    read_config
    locate
    require_sun
    phase=$(sun_phase) || die "sunwait could not tell whether it is day or night."
    set_theme "$phase" || exit 1
    set_state auto 1
    sync_timer || exit 1
    if nightlight_follows_sun; then
        apply_nightlight "$(wanted_nightlight "$phase")" 1 || exit 1
    fi
    schedule_next || exit 1
    refresh_widget
}

set_mode() {
    case "$1" in light|dark) ;; *) die "Usage: omarchy-auto-theme mode <light|dark>" ;; esac

    lock
    read_config
    set_theme "$1" || exit 1
    set_state auto 0
    locate
    sync_timer || exit 1
    schedule_next || exit 1
    refresh_widget
}

disable_auto_theme() {
    case "$1" in ""|light|dark) ;; *) die "Usage: omarchy-auto-theme disable [light|dark]" ;; esac
    [[ -n "$1" ]] && { set_mode "$1"; return; }

    lock
    read_config
    set_state auto 0
    locate
    sync_timer || exit 1
    schedule_next || exit 1
    refresh_widget
}

set_nightlight_mode() {
    local phase=""

    case "$1" in on|off|auto) ;; *) die "Usage: omarchy-auto-theme nightlight <on|off|auto>" ;; esac

    read_config
    if [[ "$1" == auto ]]; then
        command -v sunwait >/dev/null || die "Install sunwait to follow sunrise and sunset."
        ensure_location
    fi

    lock
    read_config
    locate
    if [[ "$1" == auto ]]; then
        require_sun
        phase=$(sun_phase) || die "sunwait could not tell whether it is day or night."
    fi

    NIGHTLIGHT="$1"
    apply_nightlight "$(wanted_nightlight "$phase")" 1 || exit 1
    save_config
    rm -f "$PREVIEW_FILE"
    sync_timer || exit 1
    schedule_next || exit 1
    refresh_widget
}

require_temperature() {
    valid_temperature "$1" || die "Temperature must be ${MIN_TEMPERATURE}-${MAX_TEMPERATURE}K."
}

set_temperature() {
    require_temperature "$1"

    lock
    read_config
    NIGHTLIGHT_TEMPERATURE=$((10#$1))
    locate
    apply_nightlight "$(wanted_nightlight)" 1 || exit 1
    save_config
    rm -f "$PREVIEW_FILE"
    refresh_widget
}

set_temperature_display() {
    [[ "$1" =~ ^(name|kelvin)$ ]] || die "Usage: omarchy-auto-theme temperature-display <name|kelvin>"

    lock
    read_config
    TEMPERATURE_DISPLAY="$1"
    save_config
}

# Previews expire on their own, so a panel that dies mid-drag cannot leave the
# screen at a temperature nobody saved.
preview_temperature() {
    require_temperature "$1"

    lock
    apply_temperature "$((10#$1))" || exit 1
    set_state preview "$((10#$1))"
    unlocked setsid -f "$SELF" preview-watchdog </dev/null >/dev/null 2>&1
}

restore_preview() {
    lock
    [[ -f "$PREVIEW_FILE" ]] || return 0
    if [[ "$1" == stale ]] && (( $(date +%s) - $(stat -c %Y "$PREVIEW_FILE") < PREVIEW_SECONDS )); then
        return 0
    fi

    read_config
    locate
    rm -f "$PREVIEW_FILE"
    apply_nightlight "$(wanted_nightlight)" 1 || exit 1
}

preview_watchdog() {
    local age

    while [[ -f "$PREVIEW_FILE" ]]; do
        exec 201>>"$STATE_DIR/watchdog.lock"
        flock -n "$WATCHDOG_FD" || return 0

        while [[ -f "$PREVIEW_FILE" ]]; do
            sleep 5
            age=$(( $(date +%s) - $(stat -c %Y "$PREVIEW_FILE" 2>/dev/null || date +%s) ))
            (( age >= PREVIEW_SECONDS )) && ( restore_preview stale )
        done

        # A preview that landed while this was exiting would otherwise find
        # the lock still held and go unwatched.
        exec 201>&-
    done
}

set_config() {
    local slot="$1" value="$2" mode

    valid_text "$value" || die "Values cannot contain quotes or line breaks."

    lock
    read_config

    case "$slot" in
        light|dark)
            theme_exists "$value" || die "Unknown theme: $value"
            [[ "$(theme_for "$slot")" == "$value" ]] || printf -v "$(background_var "$slot")" '%s' ""
            printf -v "$(theme_var "$slot")" '%s' "$value"
            ;;
        light-bg|dark-bg)
            mode="${slot%-bg}"
            if [[ -n "$value" ]] && ! background_list "$(theme_slug "$(theme_for "$mode")")" | grep -Fxq -- "$value"; then
                die "Unknown background for $(theme_for "$mode"): $value"
            fi
            printf -v "$(background_var "$mode")" '%s' "$value"
            ;;
        *) die "Usage: omarchy-auto-theme config <light|dark|light-bg|dark-bg> <value>" ;;
    esac

    save_config

    # Only the slot that is on screen changes anything visible.
    mode=$(state mode)
    if [[ "${slot%-bg}" == "$mode" ]]; then
        if [[ "$slot" == *-bg ]]; then
            if [[ -n "$value" && "$(current_theme)" == "$(theme_slug "$(theme_for "$mode")")" ]]; then
                apply_background "$(theme_slug "$(theme_for "$mode")")" "$value" ||
                    die "Saved, but could not apply background $value."
            fi
        else
            set_theme "$mode" || exit 1
        fi
    fi

    refresh_widget
}

# Lookups run before the change is saved, so a failed one leaves the previous
# location in place and reports why.
set_location() {
    local choice name="$2" phase

    choice=$(tr ',' ' ' <<<"$1" | awk '{ $1 = $1 } 1')

    case "$choice" in
        auto)
            LOCATION="" LOCATION_LOOKUP=ip
            rm -f "$IP_FAILED"
            lookup_ip || exit 1
            ;;
        off) ;;
        *)
            valid_location "$choice" || die "Enter latitude and longitude, like 51.51 -0.13"
            valid_text "$name" || die "Location names cannot contain quotes or line breaks."
            ;;
    esac

    lock
    read_config
    case "$choice" in
        auto) LOCATION="" LOCATION_NAME="" LOCATION_LOOKUP=ip ;;
        off) LOCATION="" LOCATION_NAME="" LOCATION_LOOKUP=off; rm -f "$IP_CACHE" "$IP_FAILED" "$IP_PLACE" ;;
        *) LOCATION="$choice" LOCATION_NAME="$name" LOCATION_LOOKUP=off ;;
    esac
    rm -f "$STATE_DIR/location.device" "$STATE_DIR/device.json" "$STATE_DIR/device.lock"
    save_config
    locate
    sync_timer || exit 1

    if follows_sun && [[ -z "$(sun_issue)" ]] && phase=$(sun_phase); then
        theme_follows_sun && { apply_theme_phase "$phase" 0 || exit 1; }
        nightlight_follows_sun && { apply_nightlight "$(wanted_nightlight "$phase")" 0 || exit 1; }
    fi
    schedule_next || exit 1
    refresh_widget
}

remove_unit() {
    local file="$USER_UNITS/$1"

    ours "$file" && rm -f "$file"
    rm -f "$USER_UNITS/timers.target.wants/$1" "$USER_UNITS/default.target.wants/$1"
}

uninstall() {
    case "$1" in ""|--purge) ;; *) die "Usage: omarchy-auto-theme uninstall [--purge]" ;; esac

    lock
    disable_timer
    systemctl --user stop "$SERVICE" >/dev/null 2>&1
    systemctl --user disable "$SERVICE" >/dev/null 2>&1
    remove_unit "$TIMER"
    remove_unit "$SERVICE"
    systemctl --user daemon-reload >/dev/null 2>&1
    systemctl --user reset-failed "$TIMER" "$SERVICE" "$NEXT_PREFIX-*" >/dev/null 2>&1
    rm -f "$PREVIEW_FILE"

    [[ "$1" == --purge ]] && rm -rf "$CONFIG_DIR" "$STATE_DIR"
    return 0
}

json_lines() { jq -Rsc 'split("\n") | map(select(length > 0))'; }

# Reads configuration, state and caches only: no lookups, scans or writes.
panel_json() {
    local mode auto=false issue sunrise sunset at event change=""

    read_config
    locate
    mode=$(state mode)
    theme_follows_sun && auto=true
    issue=$(sun_issue)
    sunrise=$(sun_time rise)
    sunset=$(sun_time set)
    [[ -z "$issue" && -z "$sunrise$sunset" ]] && issue=polar

    read -r at event <<<"$(state scheduled)"
    if ! [[ "$at" =~ ^[0-9]+$ ]] || (( at + 60 <= $(date +%s) )); then
        at="" event=""
        [[ -z "$issue" ]] && read -r at event < <(next_event)
    fi
    [[ "$event" == check ]] && at=""
    [[ -n "$at" ]] && change=$(date -d "@$at" '+%H:%M')

    jq -nc \
        --arg mode "$mode" \
        --argjson auto "$auto" \
        --arg nightlight "$NIGHTLIGHT" \
        --arg nightlightState "$(state nightlight)" \
        --argjson temperature "$NIGHTLIGHT_TEMPERATURE" \
        --arg temperatureDisplay "$TEMPERATURE_DISPLAY" \
        --arg lightTheme "$LIGHT_THEME" \
        --arg darkTheme "$DARK_THEME" \
        --arg lightBackground "$LIGHT_BACKGROUND" \
        --arg darkBackground "$DARK_BACKGROUND" \
        --argjson lightBackgrounds "$(background_list "$(theme_slug "$LIGHT_THEME")" | json_lines)" \
        --argjson darkBackgrounds "$(background_list "$(theme_slug "$DARK_THEME")" | json_lines)" \
        --arg nextChange "$change" \
        --arg nextEvent "$event" \
        --arg sunrise "$sunrise" \
        --arg sunset "$sunset" \
        --arg issue "$issue" \
        --arg location "$COORDS" \
        --arg locationSource "$(location_source)" \
        --arg place "$(place)" \
        '$ARGS.named'
}

status() {
    local issue

    read_config
    locate
    issue=$(sun_issue)
    echo "Location: ${COORDS:-not set} ($(location_source))"
    echo "Auto theme: $(theme_follows_sun && echo on || echo off) (timer $(systemctl --user is-active "$TIMER" 2>/dev/null))"
    echo "Night light: $NIGHTLIGHT, ${NIGHTLIGHT_TEMPERATURE}K"
    echo "Current mode: $(state mode || echo unknown)"
    echo "Light theme: $LIGHT_THEME${LIGHT_BACKGROUND:+ (background: $LIGHT_BACKGROUND)}"
    echo "Dark theme: $DARK_THEME${DARK_BACKGROUND:+ (background: $DARK_BACKGROUND)}"
    [[ -n "$issue" ]] && echo "Needs attention: $issue"
    echo "Sunrise: $(sun_time rise || echo unavailable)"
    echo "Sunset: $(sun_time set || echo unavailable)"
    systemctl --user list-timers "$NEXT_PREFIX-*" --no-legend 2>/dev/null | head -1
}

usage() {
    cat <<'EOF'
Usage: omarchy-auto-theme <command>

  status                         Location, mode, sun times and timer state
  mode <light|dark>              Choose a mode and stop following the sun
  enable                         Follow sunrise and sunset
  disable [light|dark]           Stop following, optionally choosing a mode
  nightlight <on|off|auto>       Control night light
  temperature <2500-5500>        Set night light warmth
  temperature-display <name|kelvin>  Show warmth as a name or in Kelvin
  preview-temperature <K>        Try a warmth; reverts after 30s unless saved
  cancel-preview                 Restore the saved night light now
  config <slot> <value>          Set light, dark, light-bg or dark-bg
  backgrounds <light|dark>       List backgrounds for that slot's theme
  location auto                  Locate automatically by IP address (default)
  location <"LAT LON"> [name]    Use fixed coordinates instead
  locate                         Refresh the automatic location when stale
  location off                   Forget the location
  uninstall [--purge]            Remove timers; --purge also removes settings
EOF
}

case "${1:-}" in
    ""|-h|--help|help) usage; exit ;;
    uninstall) uninstall "$2"; exit ;;
    zed) die "Zed integration was removed; Omarchy themes Zed itself." ;;
esac

migrate

case "$1" in
    apply) trigger ;;
    trigger) trigger "$2" ;;
    enable) enable_auto_theme ;;
    disable) disable_auto_theme "$2" ;;
    mode) set_mode "$2" ;;
    light|dark) set_mode "$1" ;;
    nightlight) set_nightlight_mode "$2" ;;
    temperature) set_temperature "$2" ;;
    preview-temperature) preview_temperature "$2" ;;
    temperature-display) set_temperature_display "$2" ;;
    cancel-preview) restore_preview ;;
    preview-watchdog) preview_watchdog ;;
    config) set_config "$2" "$3" ;;
    backgrounds)
        read_config
        case "$2" in
            light|dark) background_list "$(theme_slug "$(theme_for "$2")")" ;;
            *) die "Usage: omarchy-auto-theme backgrounds <light|dark>" ;;
        esac
        ;;
    location) set_location "$2" "$3" ;;
    locate) read_config; refresh_location ;;
    panel-json) panel_json ;;
    status) status ;;
    schedule) lock; read_config; locate; schedule_next ;;
    *) usage >&2; exit 1 ;;
esac
